# Copy to .env and adjust as needed. All values are optional; defaults shown.

# Server bind address (used by the Makefile / uvicorn)
HOST=127.0.0.1
PORT=8533

# Simulation safety limits (read by backend/main.py).
# Statevector simulation is exponential in qubits, so these cap resource use.
QCB_MAX_QUBITS=12
QCB_MAX_GATES=2000
QCB_MAX_SHOTS=100000

# ---- Real quantum hardware (IBM Quantum) -----------------------------------
# Turn this on to reveal a "Run on: Classical simulator / Quantum hardware"
# toggle in the UI. Leave false to keep the app purely classical.
QCB_ENABLE_QUANTUM_HW=false

# Which backend a quantum-mode run targets:
#   aer         -> local Aer simulator: no credentials, instant, counts-only.
#                  (Use this to test the quantum path without spending QPU time;
#                   IBM retired its hosted cloud simulators in 2024.)
#   least_busy  -> the least-busy real IBM device (needs token + instance below)
#   <name>      -> a specific device, e.g. ibm_brisbane
QCB_IBM_BACKEND=aer

# IBM Quantum Platform credentials (only needed for real devices, not for aer).
# Create an API key + instance at https://quantum.cloud.ibm.com and paste here.
# NOTE: keep real values out of version control — .env is gitignored.
QCB_IBM_CHANNEL=ibm_quantum_platform
QCB_IBM_TOKEN=
QCB_IBM_INSTANCE=
