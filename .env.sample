# Copy to .env and adjust as needed. All values are optional; defaults shown.

# Server bind address (used by the Makefile / uvicorn)
HOST=127.0.0.1
PORT=8533

# Simulation safety limits (read by backend/core.py).
# Statevector simulation is exponential in qubits, so these cap resource use.
# Raise for bigger circuits, but exact-sim memory doubles per qubit (2^n), so
# the live sim slows past ~16-18 qubits and is infeasible in the low 20s.
QCB_MAX_QUBITS=16
QCB_MAX_GATES=2000
QCB_MAX_SHOTS=100000

# ---- Tutor memory (optional Postgres) --------------------------------------
# The core playground (build / simulate / explain) needs no database. These
# back the *memory* features — learner profiles, study sessions, and quizzes
# (and, later, pgvector semantic recall). Leave QCB_DATABASE_URL unset to run
# fully in-memory; the memory features then report themselves unavailable
# (HTTP 503) and everything else works.
#
# Quick start: `make db-up` brings up the bundled Postgres (pgvector image) with
# the credentials below, then `make migrate` applies the schema. The connection
# string is psycopg3's native libpq form (postgresql://...); Alembic adapts it.
QCB_DATABASE_URL=postgresql://qcb:qcb@localhost:5432/qcb
#
# Credentials + host port for the docker-compose `db` service. Keep these in sync
# with QCB_DATABASE_URL above. QCB_DB_PORT is the *host* port (change it if you
# already run Postgres on 5432); the container always listens on 5432 internally.
QCB_DB_USER=qcb
QCB_DB_PASSWORD=qcb
QCB_DB_NAME=qcb
QCB_DB_PORT=5432
#
# How many seconds to wait for a connection before timing out (default 3).
# Lower values fail fast when the DB is unreachable; raise if your network adds
# latency (e.g. remote Postgres, VPN).
#QCB_DB_CONNECT_TIMEOUT=3
#
# How many professor turns between automatic quiz triggers. Set to 0 to disable
# auto-quizzing (students can still click "Quiz me" manually).
#QCB_QUIZ_INTERVAL=3
#
# Sentence-transformers model used for local interaction embeddings (pgvector
# semantic recall). The default is tiny and fast on CPU; swap for a larger model
# if accuracy matters more than startup time.
#QCB_EMBED_MODEL=all-MiniLM-L6-v2

# ---- Real quantum hardware -------------------------------------------------
# Turn this on to reveal a "Run on: Classical simulator / Quantum hardware"
# toggle in the UI. Leave false to keep the app purely classical.
QCB_ENABLE_QUANTUM_HW=false

# How many quantum-hardware runs may be in flight at once. The Queue tab shows
# each run (pending → circuit → measured results); at this many pending runs the
# Run button is disabled until one finishes. Minimum 1.
QCB_QUEUE_MAX=2

# Which cloud provider services a quantum-mode run: ibm (IBM Quantum via Qiskit
# Runtime) or braket (AWS Braket). Each has a no-credentials local-simulator
# default, so the toggle works out of the box without an account on either.
QCB_QUANTUM_PROVIDER=ibm

# --- IBM Quantum (Qiskit Runtime) — used when QCB_QUANTUM_PROVIDER=ibm ---
# Which backend a quantum-mode run targets:
#   aer         -> local Aer simulator: no credentials, instant, counts-only.
#                  (Use this to test the quantum path without spending QPU time;
#                   IBM retired its hosted cloud simulators in 2024.)
#   least_busy  -> the least-busy real IBM device (needs token + instance below)
#   <name>      -> a specific device, e.g. ibm_brisbane
QCB_IBM_BACKEND=aer
# IBM Quantum Platform credentials (only needed for real devices, not for aer).
# Create an API key + instance at https://quantum.cloud.ibm.com and paste here.
# NOTE: keep real values out of version control — .env is gitignored.
QCB_IBM_CHANNEL=ibm_quantum_platform
QCB_IBM_TOKEN=
QCB_IBM_INSTANCE=

# --- AWS Braket — used when QCB_QUANTUM_PROVIDER=braket ---
# Needs `pip install amazon-braket-sdk`. Which device a quantum-mode run targets:
#   local       -> on-machine LocalSimulator: no AWS account, instant, counts-only.
#   <ARN>       -> an AWS Braket device ARN — an on-demand simulator such as
#                  arn:aws:braket:::device/quantum-simulator/amazon/sv1, or a real
#                  QPU ARN. Real devices bill your AWS account and may queue.
# Real devices authenticate via the standard AWS credential chain (AWS_ACCESS_KEY_ID
# / AWS_SECRET_ACCESS_KEY or a shared profile) and AWS_REGION — set those in your
# shell/AWS config, not here; this app never reads or stores AWS secrets.
QCB_BRAKET_DEVICE=local

# ---- AI "Professor" (circuit explainer + Q&A) ------------------------------
# Reveals a "Professor" tab: a friendly instructor that explains what the current
# circuit does in plain language, answers your specific questions, and remembers
# the conversation. Disabled unless QCB_ENABLE_AI is true AND at least one provider
# is configured, so a stray key never silently enables it.
QCB_ENABLE_AI=false

# There are two ways to configure providers:
#
# (A) Single-provider (simplest). Set QCB_AI_PROVIDER to anthropic | gemini | openai
#     | llama, plus QCB_AI_MODEL and QCB_AI_API_KEY. The UI shows just that provider.
QCB_AI_PROVIDER=anthropic
QCB_AI_MODEL=claude-opus-4-7

# --- anthropic (Claude) ---
# Your Claude API key. Create one at https://platform.claude.com -> API Keys.
# Keep real values out of version control — .env is gitignored.
QCB_AI_API_KEY=

# (B) Multi-provider (pick provider + model live in the UI). Toggle each provider
#     on with QCB_PROVIDER_<NAME>=true and give it its own key; only providers that
#     are toggled on (and have a key, where needed) appear in the UI's Provider and
#     Model dropdowns. Optionally override the offered models with
#     QCB_<NAME>_MODELS (comma list) and the default with QCB_<NAME>_MODEL.
#     Keys are read server-side only and never returned to the browser or logged.
#
# QCB_PROVIDER_ANTHROPIC=true
# QCB_ANTHROPIC_API_KEY=
# QCB_ANTHROPIC_MODEL=claude-opus-4-7
# QCB_ANTHROPIC_MODELS=claude-opus-4-7,claude-sonnet-4-6,claude-haiku-4-5
#
# QCB_PROVIDER_GEMINI=true
# QCB_GEMINI_API_KEY=                       # https://aistudio.google.com/app/apikey
# QCB_GEMINI_MODEL=gemini-2.0-flash
#
# QCB_PROVIDER_OPENAI=true
# QCB_OPENAI_API_KEY=                        # https://platform.openai.com/api-keys
# QCB_OPENAI_MODEL=gpt-4o
#
# QCB_PROVIDER_LLAMA=true                    # local, no key (see Ollama notes below)
# QCB_LLAMA_MODEL=llama3.2

# --- gemini (Google) ---
# Single-provider mode: set QCB_AI_PROVIDER=gemini, QCB_AI_MODEL=gemini-2.0-flash
# (or another Gemini model), and put the key in QCB_AI_API_KEY above. Get a key at
# https://aistudio.google.com/app/apikey. The key is sent in a request header,
# never in the URL, and is never logged.

# --- openai (ChatGPT) ---
# Single-provider mode: set QCB_AI_PROVIDER=openai, QCB_AI_MODEL=gpt-4o (or another
# chat model), and put the key in QCB_AI_API_KEY above. Get a key at
# https://platform.openai.com/api-keys. The key is sent in the Authorization
# header, never in the URL, and is never logged.

# --- llama (local, via Ollama) ---
# To run the Professor on a local Llama model (no API key, no cloud):
#   1. Install Ollama (https://ollama.com) and run `ollama serve`.
#   2. Pull a model, e.g. `ollama pull llama3.2`.
#   3. Set QCB_AI_PROVIDER=llama and QCB_AI_MODEL=llama3.2 (no API key needed).
# QCB_AI_LLAMA_HOST points at the Ollama server (default shown).
QCB_AI_LLAMA_HOST=http://localhost:11434
